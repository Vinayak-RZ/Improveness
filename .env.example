# OAuth clients for in-tree oh-my-pi (not committed).
# Upstream ships public desktop clients; GitHub push protection blocks copies here.
# Copy values from a local upstream checkout or your own OAuth app.

# OMP_GOOGLE_ANTIGRAVITY_CLIENT_ID=
# OMP_GOOGLE_ANTIGRAVITY_CLIENT_SECRET=
# OMP_GOOGLE_GEMINI_CLI_CLIENT_ID=
# OMP_GOOGLE_GEMINI_CLI_CLIENT_SECRET=
# OMP_ANTHROPIC_OAUTH_CLIENT_ID=

# Optional LLM keys for live createAgentSession smoke (never required for qa.sh).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Optional live createAgentSession smoke (never required for validate.sh).
# OMP_LIVE_SMOKE=1
# Optional live DSH profile smoke (never required for qa.sh). Skip-gated in CI.
# DSH_LIVE_SMOKE=1
# DEEPSEEK_API_KEY=
# Optional live ModelTaste fit before/after (never required for qa.sh).
# IMPROVENESS_FIT_LIVE=1
# IMPROVENESS_FIT_MODEL=deepseek-chat
# Optional live evolver search (never required for validate.sh).
# OMP_LIVE_SEARCH=1
# Optional root of the agent tree to mutate after the gate (default: in-tree oh-my-pi/).
# OMP_SNAPSHOT_ROOT=
