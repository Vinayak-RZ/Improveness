{
  "version": 8,
  "description": "Coding Cursor config — 30 skills, 21 rules, 3 always-on stubs, agent-patterns MCP, nawab-plans profiles + opt-in graph-engineering XOR graph-of-loops + ponytail + Spec Kit v1.0.6",
  "mcp": {
    "default_server": "agent-patterns",
    "url": "https://mcp.agentpatternscatalog.org/mcp",
    "docs": "docs/MCP_SETUP.md",
    "catalog": "docs/mcp-catalog.json"
  },
  "spec_kit": {
    "source": "https://github.com/github/spec-kit",
    "pinned_version": "v1.0.6",
    "install_script": "scripts/install-spec-kit.ps1",
    "docs": "docs/SPEC_KIT.md",
    "rule": "speckit"
  },
  "preinstalled": {
    "count": 30,
    "categories": {
      "planning": ["nawab-plans", "graph-engineering", "graph-of-loops"],
      "minimal-code": [
        "ponytail",
        "ponytail-review",
        "ponytail-audit",
        "ponytail-debt",
        "ponytail-gain",
        "ponytail-help"
      ],
      "spec-driven": ["speckit"],
      "architecture": [
        "frontend-architecture",
        "backend-architecture",
        "agentic-system-design",
        "system-design-tradeoffs"
      ],
      "nextjs": ["nextjs-app-router-patterns", "vercel-react-best-practices"],
      "documentation": ["readme", "product-readme", "readable-readme", "extensive-readme", "copywriting"],
      "learning": ["learn-while-building"],
      "animation": ["gsap-framer-scroll-animation"],
      "ui": ["impeccable", "web-design-guidelines", "frontend-design"],
      "computer-use": ["computer-use", "agent-browser"],
      "exploration": ["graphify"],
      "utility": ["find-skills"]
    }
  },
  "rules": {
    "always_apply": [
      "rule-awareness",
      "ponytail",
      "ai-anti-patterns"
    ],
    "contextual": [
      "planning",
      "execution",
      "quality-gates",
      "git-commit-discipline",
      "trade-offs",
      "frontend-architecture",
      "backend-architecture",
      "agentic-systems",
      "security-baseline",
      "testing-discipline",
      "tech-stack-skills",
      "mcp-architecture",
      "speckit"
    ]
  },
  "workflows": {
    "implementation": "nawab-plans (lite default) → approve → implement; opt-in graph-engineering XOR graph-of-loops in §19",
    "spec_driven": "constitution → specify → plan → tasks → implement (ponytail on code)",
    "learning": "docs/LEARNING_AND_RESEARCH.md",
    "commits": "conventional commits after milestones; auto-push at 10 unpushed or when user asks"
  },
  "optional_catalog": [
    {
      "name": "senior-architect",
      "installs": 1800,
      "command": "npx skills add sickn33/antigravity-awesome-skills@senior-architect -y --copy",
      "when": "Holistic system design reviews"
    },
    {
      "name": "agent-arch-system-design",
      "installs": 854,
      "command": "npx skills add ruvnet/ruflo@agent-arch-system-design -y --copy",
      "when": "Supplement agentic-system-design skill"
    },
    {
      "name": "security-reviewer",
      "installs": 3400,
      "command": "npx skills add jeffallan/claude-skills@security-reviewer -y --copy",
      "when": "Prefer Cursor /review-security for auth, payments, sensitive API changes"
    },
    {
      "name": "frontend-developer",
      "installs": 806,
      "command": "npx skills add sickn33/antigravity-awesome-skills@frontend-developer -y --copy",
      "when": "General frontend implementation depth"
    },
    {
      "name": "backend-design",
      "installs": 86,
      "command": "npx skills add dauquangthanh/hanoi-rainbow@backend-design -y --copy",
      "when": "Supplement backend-architecture skill"
    }
  ]
}
